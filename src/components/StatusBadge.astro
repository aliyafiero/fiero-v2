---
import { describeStatus, type StatusBadgeProps } from '../data/contentStatus';

type Props = StatusBadgeProps;
const { asOf, reference } = Astro.props;
const status = describeStatus(Astro.props);
---

<a class="status-badge" href={reference} title={status.description}>
  <span class="status-category">{status.category}</span>
  <strong>{status.label}</strong>
  <span>As of <time datetime={asOf}>{status.dateLabel}</time></span>
</a>

<style>
  .status-badge {
    display: inline-flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: .25rem .5rem;
    max-width: 100%;
    padding: .4rem .7rem;
    border: 1px solid currentColor;
    border-radius: var(--radius-sm, 14px);
    color: inherit;
    font-size: .75rem;
    line-height: 1.5;
    overflow-wrap: anywhere;
    text-decoration: none;
  }
  .status-category { font-weight: 500; }
  .status-badge strong { font-weight: 700; }
  .status-badge:hover { text-decoration: underline; }
  .status-badge:focus-visible { outline: 2px solid currentColor; outline-offset: 4px; }
</style>
