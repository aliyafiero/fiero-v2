  .assessment-intro-copy>p{font-size:clamp(18px,2vw,22px);color:var(--muted);max-width:780px;margin:0}
  .assessment-trust{display:grid;grid-template-columns:repeat(3,1fr);gap:1px;margin:48px 0;background:var(--line);border:1px solid var(--line);border-radius:16px;overflow:hidden}
  .assessment-trust span{padding:17px 20px;background:var(--bg-deep);font-size:13px;color:var(--muted)}
  .assessment-trust strong{color:var(--mint)}
  .assessment-welcome{display:grid;grid-template-columns:1fr auto;gap:42px;align-items:end;border:1px solid var(--line);border-radius:28px;padding:42px;background:linear-gradient(135deg,rgba(191,239,75,.045),rgba(255,255,255,.015))}
  .assessment-welcome h2,.assessment-section-heading h2,.results-heading h2,.recommendations>h2,.contact-intro h2{font-size:clamp(30px,4vw,46px);line-height:1.12;letter-spacing:-.02em;font-weight:600;margin:10px 0 14px}
  .assessment-welcome p,.assessment-section-heading p,.results-heading p,.contact-intro p{color:var(--muted);margin:0;max-width:720px}
  .assessment-kicker{color:var(--lime);font-size:11px;font-weight:700;letter-spacing:.13em;text-transform:uppercase}
  .assessment-start{white-space:nowrap}
  .assessment-stage{display:grid;grid-template-columns:230px minmax(0,1fr);gap:32px;align-items:start}
  .assessment-progress{position:sticky;top:108px;border:1px solid var(--line);border-radius:18px;padding:22px;background:rgba(0,27,33,.52)}
  .progress-label{font-size:12px;color:var(--muted);margin-bottom:12px}
  .progress-track{height:5px;border-radius:999px;background:rgba(234,243,239,.1);overflow:hidden}
  .progress-track span{display:block;height:100%;width:0;background:var(--lime);border-radius:inherit;transition:width .3s ease}
  .assessment-progress ol{list-style:none;padding:0;margin:22px 0 0;display:grid;gap:13px}
  .assessment-progress li{display:flex;gap:9px;align-items:center;color:var(--mist);font-size:12px}
  .assessment-progress li span{display:inline-flex;align-items:center;justify-content:center;width:25px;height:25px;border:1px solid var(--line);border-radius:50%;font-size:9px;flex:none}
  .assessment-progress li.current{color:var(--mint)}
  .assessment-progress li.current span,.assessment-progress li.complete span{border-color:var(--line-strong);color:var(--lime);background:rgba(191,239,75,.05)}
  .assessment-panel{border:1px solid var(--line);border-radius:26px;padding:38px;background:rgba(255,255,255,.018)}
  .assessment-section-heading{padding-bottom:30px;border-bottom:1px solid var(--line)}
  .assessment-section-heading h2:focus,.results-heading h2:focus{outline:none}
  .assessment-question{border:0;padding:30px 0;margin:0;border-bottom:1px solid var(--line)}
  .assessment-question.invalid{margin:20px -16px 0;padding:20px 16px;border:1px solid rgba(255,145,126,.6);border-radius:14px}
  .assessment-question legend{font-family:"Manrope","Inter",sans-serif;font-size:19px;line-height:1.3;font-weight:600;padding:0;margin-bottom:17px;color:var(--mint)}
  .optional-label{display:inline-block;margin-left:8px;font-family:"Inter",sans-serif;font-size:10px;letter-spacing:.09em;text-transform:uppercase;color:var(--mist);vertical-align:middle}
  .answer-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:10px}
  .answer-option,.review-checkbox{position:relative;display:flex;align-items:flex-start;gap:12px;padding:14px 15px;border:1px solid var(--line);border-radius:12px;background:rgba(255,255,255,.015);color:var(--muted);font-size:14px;line-height:1.4;cursor:pointer;transition:border-color .18s ease,background .18s ease,color .18s ease}
  .answer-option:hover{border-color:rgba(191,239,75,.34);color:var(--mint)}
