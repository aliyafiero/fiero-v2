<section class="assessment-experience" data-assessment-root aria-labelledby="assessment-title">
  <div class="wrap assessment-wrap">
    <header class="assessment-intro-copy">
      <div class="eyebrow">Identity Environment Assessment</div>
      <h1 id="assessment-title">Assess Your Identity Environment</h1>
      <p>See where your identity foundation is strong, where operational friction remains, and what to prioritize next.</p>
    </header>

    <div class="assessment-trust" aria-label="Assessment details">
      <span><strong>~4 minutes</strong> to complete</span>
      <span><strong>No credentials</strong> or configuration exports</span>
      <span><strong>Results first</strong> — contact details are optional</span>
    </div>

    <div class="assessment-welcome" data-assessment-intro>
      <div>
        <span class="assessment-kicker">A practical baseline</span>
        <h2>Answer at the level your team can confidently describe today.</h2>
        <p>This assessment looks at architecture, lifecycle, automation, governance, security, and emerging non-human identity controls. It never requests production access or sensitive customer data.</p>
      </div>
      <button class="button primary assessment-start" type="button" data-assessment-start>Begin assessment <span aria-hidden="true">→</span></button>
    </div>

    <div class="assessment-stage" data-assessment-stage hidden>
      <aside class="assessment-progress" aria-label="Assessment progress">
        <div class="progress-label" data-progress-label>Step 1 of 7</div>
        <div class="progress-track" role="progressbar" aria-label="Assessment completion" aria-valuemin="1" aria-valuemax="7" aria-valuenow="1" data-progress-bar>
          <span data-progress-fill></span>
        </div>
        <ol data-progress-steps></ol>
      </aside>

      <div class="assessment-panel" data-question-panel>
        <div class="assessment-section-heading">
          <div class="assessment-kicker" data-section-eyebrow></div>
          <h2 tabindex="-1" data-section-title></h2>
          <p data-section-description></p>
        </div>
        <form data-question-form novalidate>
          <div data-question-list></div>
          <div class="assessment-error" role="alert" aria-live="polite" data-assessment-error></div>
          <div class="assessment-controls">
            <button class="button ghost" type="button" data-previous>← Previous</button>
            <button class="button primary" type="submit" data-continue>Continue →</button>
          </div>
        </form>
      </div>
    </div>

    <div class="assessment-results" data-assessment-results hidden aria-live="polite"></div>
  </div>
</section>

<script>
  import {
    assessmentSections,
    conditionMatches,
    getVisibleQuestions,
    getVisibleSections,
    type AnswerValue,
    type AssessmentQuestion,
    type AssessmentResponses
  } from '../../data/assessment';
  import { scoreAssessment, type AssessmentScores } from '../../lib/assessment/scoring';
  import { interpretAssessment, type Recommendation } from '../../lib/assessment/recommendations';
  import {
    isSubmissionConfigured,
    submitAssessment,
    type AssessmentContact,
    type AssessmentSubmission
  } from '../../lib/assessment/submission';

  const root = document.querySelector<HTMLElement>('[data-assessment-root]');

  if (root) {
    const storageKey = 'fiero-identity-assessment-v1';
    const intro = root.querySelector<HTMLElement>('[data-assessment-intro]')!;
    const startButton = root.querySelector<HTMLButtonElement>('[data-assessment-start]')!;
    const stage = root.querySelector<HTMLElement>('[data-assessment-stage]')!;
    const resultsPanel = root.querySelector<HTMLElement>('[data-assessment-results]')!;
    const questionForm = root.querySelector<HTMLFormElement>('[data-question-form]')!;
    const questionList = root.querySelector<HTMLElement>('[data-question-list]')!;
    const sectionEyebrow = root.querySelector<HTMLElement>('[data-section-eyebrow]')!;
    const sectionTitle = root.querySelector<HTMLElement>('[data-section-title]')!;
    const sectionDescription = root.querySelector<HTMLElement>('[data-section-description]')!;
    const progressLabel = root.querySelector<HTMLElement>('[data-progress-label]')!;
    const progressBar = root.querySelector<HTMLElement>('[data-progress-bar]')!;
    const progressFill = root.querySelector<HTMLElement>('[data-progress-fill]')!;
    const progressSteps = root.querySelector<HTMLOListElement>('[data-progress-steps]')!;
    const previousButton = root.querySelector<HTMLButtonElement>('[data-previous]')!;
    const errorMessage = root.querySelector<HTMLElement>('[data-assessment-error]')!;

    let responses: AssessmentResponses = {};
    let currentSectionId = assessmentSections[0].id;
    let showingResults = false;

    const escapeHtml = (value: string): string => value
      .replaceAll('&', '&amp;')
      .replaceAll('<', '&lt;')
      .replaceAll('>', '&gt;')
      .replaceAll('"', '&quot;')
      .replaceAll("'", '&#039;');

    const hasAnswer = (value: AnswerValue | undefined): boolean => Array.isArray(value) ? value.length > 0 : Boolean(value);

    const restoreProgress = () => {
      try {
        const stored = sessionStorage.getItem(storageKey);
        if (!stored) return;
        const parsed = JSON.parse(stored) as {
          responses?: AssessmentResponses;
          currentSectionId?: string;
          showingResults?: boolean;
        };
        responses = parsed.responses ?? {};
        currentSectionId = parsed.currentSectionId ?? assessmentSections[0].id;
        showingResults = Boolean(parsed.showingResults);
      } catch {
        sessionStorage.removeItem(storageKey);
      }
    };

    const saveProgress = () => {
      sessionStorage.setItem(storageKey, JSON.stringify({ responses, currentSectionId, showingResults }));
    };

    const removeHiddenAnswers = () => {
      for (const section of assessmentSections) {
        if (!conditionMatches(section.when, responses)) {
          section.questions.forEach((question) => delete responses[question.id]);
          continue;
        }
        section.questions.forEach((question) => {
          if (!conditionMatches(question.when, responses)) delete responses[question.id];
        });
      }
    };

    const renderProgress = () => {
      const sections = getVisibleSections(responses);
      let index = sections.findIndex((section) => section.id === currentSectionId);
      if (index < 0) {
        index = 0;
        currentSectionId = sections[0].id;
      }
      const step = index + 1;
      const percent = Math.round((step / sections.length) * 100);

      progressLabel.textContent = `Step ${step} of ${sections.length}`;
      progressBar.setAttribute('aria-valuemax', String(sections.length));
      progressBar.setAttribute('aria-valuenow', String(step));
      progressFill.style.width = `${percent}%`;
      progressSteps.innerHTML = sections.map((section, sectionIndex) => `
        <li class="${sectionIndex === index ? 'current' : ''} ${sectionIndex < index ? 'complete' : ''}">
          <span>${sectionIndex < index ? '✓' : String(sectionIndex + 1).padStart(2, '0')}</span>
          ${escapeHtml(section.eyebrow)}
        </li>
      `).join('');
      previousButton.disabled = index === 0;
    };

    const answerMarkup = (question: AssessmentQuestion): string => {
      const answer = responses[question.id];
      const inputType = question.type === 'multi' ? 'checkbox' : 'radio';
      const optional = question.required === false ? '<span class="optional-label">Optional</span>' : '';

      return `
        <fieldset class="assessment-question" data-question-id="${escapeHtml(question.id)}">
          <legend>${escapeHtml(question.prompt)} ${optional}</legend>
          <div class="answer-grid">
            ${question.options.map((item) => {
              const checked = Array.isArray(answer) ? answer.includes(item.value) : answer === item.value;
              return `
                <label class="answer-option">
                  <input type="${inputType}" name="${escapeHtml(question.id)}" value="${escapeHtml(item.value)}" ${checked ? 'checked' : ''} />
                  <span class="answer-control" aria-hidden="true"></span>
                  <span>${escapeHtml(item.label)}</span>
                </label>
              `;
            }).join('')}
          </div>
        </fieldset>
      `;
    };

    const readQuestionAnswer = (question: AssessmentQuestion): AnswerValue => {
      const inputs = [...questionList.querySelectorAll<HTMLInputElement>(`input[name="${question.id}"]`)];
      if (question.type === 'multi') return inputs.filter((input) => input.checked).map((input) => input.value);
      return inputs.find((input) => input.checked)?.value ?? '';
    };

    const applyExclusiveOption = (question: AssessmentQuestion, changedInput: HTMLInputElement) => {
      const exclusiveByQuestion: Record<string, string> = {
        priorities: 'assess-current',
        platforms: 'not-sure',
        automationTools: 'manual'
      };
      const exclusiveValue = exclusiveByQuestion[question.id];
      if (!exclusiveValue || !changedInput.checked) return;
      const inputs = [...questionList.querySelectorAll<HTMLInputElement>(`input[name="${question.id}"]`)];
      if (changedInput.value === exclusiveValue) {
        inputs.forEach((input) => { if (input !== changedInput) input.checked = false; });
      } else {
        const exclusive = inputs.find((input) => input.value === exclusiveValue);
        if (exclusive) exclusive.checked = false;
      }
    };

    const renderSection = (focusHeading = false) => {
      intro.hidden = true;
      resultsPanel.hidden = true;
      stage.hidden = false;

      const sections = getVisibleSections(responses);
      const section = sections.find((item) => item.id === currentSectionId) ?? sections[0];
      currentSectionId = section.id;
      const questions = getVisibleQuestions(section, responses);

      sectionEyebrow.textContent = section.eyebrow;
      sectionTitle.textContent = section.title;
      sectionDescription.textContent = section.description;
      questionList.innerHTML = questions.map(answerMarkup).join('');
      errorMessage.textContent = '';
      renderProgress();

      questionList.querySelectorAll<HTMLInputElement>('input').forEach((input) => {
        input.addEventListener('change', () => {
          const question = questions.find((item) => item.id === input.name);
          if (!question) return;
          applyExclusiveOption(question, input);
          responses[question.id] = readQuestionAnswer(question);
          removeHiddenAnswers();
          saveProgress();

          const changesCurrentQuestions = section.questions.some((item) => item.when?.questionId === question.id);
          if (changesCurrentQuestions) renderSection();
          else renderProgress();
        });
      });

      if (focusHeading) sectionTitle.focus();
    };

    const validateCurrentSection = (): boolean => {
      const section = getVisibleSections(responses).find((item) => item.id === currentSectionId);
      if (!section) return false;
      const missing = getVisibleQuestions(section, responses).find((question) => question.required !== false && !hasAnswer(responses[question.id]));
      questionList.querySelectorAll('.assessment-question.invalid').forEach((item) => item.classList.remove('invalid'));

      if (!missing) {
        errorMessage.textContent = '';
        return true;
      }

      errorMessage.textContent = 'Please answer each required question before continuing.';
      const fieldset = questionList.querySelector<HTMLElement>(`[data-question-id="${missing.id}"]`);
      fieldset?.classList.add('invalid');
      fieldset?.querySelector<HTMLInputElement>('input')?.focus();
      return false;
    };

    const scoreMarkup = (scores: AssessmentScores): string => Object.values(scores).map((result) => {
      const applicable = result.score !== null;
      return `
        <article class="dimension-card ${applicable ? '' : 'not-applicable'}">
          <div class="dimension-heading">
            <h3>${escapeHtml(result.label)}</h3>
            <strong>${applicable ? `${result.score}` : 'N/A'}</strong>
          </div>
          <div class="score-track" aria-hidden="true"><span style="width:${applicable ? result.score : 0}%"></span></div>
          <div class="dimension-band">${escapeHtml(result.band)}</div>
        </article>
      `;
    }).join('');

    const listMarkup = (items: string[]): string => `<ul>${items.map((item) => `<li>${escapeHtml(item)}</li>`).join('')}</ul>`;

    const recommendationMarkup = (recommendations: Recommendation[]): string => recommendations.map((recommendation, index) => `
      <article class="recommendation-card">
        <span>0${index + 1}</span>
        <div><h3>${escapeHtml(recommendation.title)}</h3><p>${escapeHtml(recommendation.description)}</p></div>
      </article>
    `).join('');

    const bindContactForm = (scores: AssessmentScores, recommendations: Recommendation[]) => {
      const form = resultsPanel.querySelector<HTMLFormElement>('[data-contact-form]');
      const status = resultsPanel.querySelector<HTMLElement>('[data-submission-status]');
      const submitButton = resultsPanel.querySelector<HTMLButtonElement>('[data-submit-profile]');
      if (!form || !status || !submitButton) return;

      if (!isSubmissionConfigured()) {
        status.textContent = 'Form delivery is not configured in this environment. Your assessment results remain available above.';
        status.classList.add('neutral');
      }

      form.addEventListener('submit', async (event) => {
        event.preventDefault();
        if (!form.reportValidity()) return;

        const formData = new FormData(form);
        const contact: AssessmentContact = {
          name: String(formData.get('name') ?? ''),
          email: String(formData.get('email') ?? ''),
          company: String(formData.get('company') ?? ''),
          role: String(formData.get('role') ?? ''),
          context: String(formData.get('context') ?? ''),
          reviewRequested: formData.get('reviewRequested') === 'yes'
        };
        const payload: AssessmentSubmission = {
          contact,
          responses,
          scores,
          recommendations,
          timestamp: new Date().toISOString()
        };

        submitButton.disabled = true;
        submitButton.textContent = 'Sending…';
        status.textContent = '';
        status.className = 'submission-status';

        const result = await submitAssessment(payload);
        status.textContent = result.message;
        status.classList.add(result.ok ? 'success' : 'error');
        submitButton.disabled = false;
        submitButton.textContent = 'Send my assessment profile';
      });
    };

    const renderResults = (focusHeading = false) => {
      showingResults = true;
      saveProgress();
      intro.hidden = true;
      stage.hidden = true;
      resultsPanel.hidden = false;

      const scores = scoreAssessment(responses);
      const interpretation = interpretAssessment(responses, scores);

      resultsPanel.innerHTML = `
        <header class="results-heading">
          <div class="assessment-kicker">Your assessment profile</div>
          <h2 tabindex="-1" data-results-title>A dimension-by-dimension view of your identity environment.</h2>
          <p>These results are directional, deterministic, and based only on the answers you provided. They are not a security certification or technical audit.</p>
        </header>

        <div class="dimension-grid">${scoreMarkup(scores)}</div>

        <div class="interpretation-grid">
          <section><div class="assessment-kicker">What looks strong</div>${listMarkup(interpretation.strengths)}</section>
          <section><div class="assessment-kicker">Where we'd focus next</div>${listMarkup(interpretation.focusAreas)}</section>
        </div>

        <section class="recommendations">
          <div class="assessment-kicker">Top 3 recommended priorities</div>
          <h2>A focused sequence for what comes next.</h2>
          <div class="recommendation-list">${recommendationMarkup(interpretation.recommendations)}</div>
        </section>

        <section class="contact-capture">
          <div class="contact-intro">
            <div class="assessment-kicker">Optional next step</div>
            <h2>Want to keep this profile?</h2>
            <p>Get a copy of your results, or have a Fiero identity specialist review the profile and suggest next steps.</p>
          </div>
          <form data-contact-form>
            <div class="contact-fields">
              <label><span>Name</span><input name="name" autocomplete="name" required /></label>
              <label><span>Work email</span><input type="email" name="email" autocomplete="email" required /></label>
              <label><span>Company</span><input name="company" autocomplete="organization" required /></label>
              <label><span>Role</span><input name="role" autocomplete="organization-title" required /></label>
              <label class="full-width"><span>Project / context <small>Optional</small></span><textarea name="context" rows="4"></textarea></label>
              <label class="review-checkbox full-width">
                <input type="checkbox" name="reviewRequested" value="yes" />
                <span class="answer-control" aria-hidden="true"></span>
                <span>I'd like Fiero to review my assessment and contact me.</span>
              </label>
            </div>
            <p class="privacy-note">Your contact details and assessment profile are only sent when you submit this form.</p>
            <button class="button primary" type="submit" data-submit-profile>Send my assessment profile</button>
            <p class="submission-status" role="status" aria-live="polite" data-submission-status></p>
          </form>
        </section>

        <div class="results-actions">
          <button class="button ghost" type="button" data-back-to-assessment>← Review answers</button>
          <button class="text-button" type="button" data-restart-assessment>Start over</button>
        </div>
      `;

      bindContactForm(scores, interpretation.recommendations);
      resultsPanel.querySelector<HTMLButtonElement>('[data-back-to-assessment]')?.addEventListener('click', () => {
        const sections = getVisibleSections(responses);
        currentSectionId = sections[sections.length - 1].id;
        showingResults = false;
        saveProgress();
        renderSection(true);
      });
      resultsPanel.querySelector<HTMLButtonElement>('[data-restart-assessment]')?.addEventListener('click', () => {
        responses = {};
        currentSectionId = assessmentSections[0].id;
        showingResults = false;
        sessionStorage.removeItem(storageKey);
        renderSection(true);
      });

      if (focusHeading) resultsPanel.querySelector<HTMLElement>('[data-results-title]')?.focus();
    };

    questionForm.addEventListener('submit', (event) => {
      event.preventDefault();
      if (!validateCurrentSection()) return;

      const sections = getVisibleSections(responses);
      const index = sections.findIndex((section) => section.id === currentSectionId);
      if (index < sections.length - 1) {
        currentSectionId = sections[index + 1].id;
        saveProgress();
        renderSection(true);
      } else {
        renderResults(true);
      }
    });

    previousButton.addEventListener('click', () => {
      const sections = getVisibleSections(responses);
      const index = sections.findIndex((section) => section.id === currentSectionId);
      if (index <= 0) return;
      currentSectionId = sections[index - 1].id;
      saveProgress();
      renderSection(true);
    });

    restoreProgress();
    const hasSavedProgress = Object.keys(responses).length > 0 || showingResults;
    if (hasSavedProgress) startButton.innerHTML = 'Resume assessment <span aria-hidden="true">→</span>';
    startButton.addEventListener('click', () => {
      if (showingResults) renderResults(true);
      else renderSection(true);
    });
  }
</script>

<style is:global>
  .assessment-experience{padding:88px 0 120px;min-height:calc(100vh - 76px)}
  .assessment-wrap{max-width:1100px}
  .assessment-intro-copy{max-width:880px}
