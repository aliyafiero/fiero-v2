  .answer-control{width:17px;height:17px;border:1px solid var(--mist);border-radius:50%;flex:none;margin-top:1px;display:flex;align-items:center;justify-content:center}
  input[type="checkbox"]+.answer-control{border-radius:5px}
  .answer-option input:checked+.answer-control,.review-checkbox input:checked+.answer-control{border-color:var(--lime);background:var(--lime);box-shadow:inset 0 0 0 4px var(--bg-deep)}
  .answer-option input:focus-visible+.answer-control,.review-checkbox input:focus-visible+.answer-control{outline:3px solid rgba(191,239,75,.35);outline-offset:3px}
  .assessment-error{min-height:24px;padding-top:16px;color:#FFB8A9;font-size:13px}
  .assessment-controls{display:flex;align-items:center;justify-content:space-between;gap:16px;padding-top:20px}
  .assessment-controls button:disabled{opacity:.35;cursor:not-allowed}
  .assessment-results{display:grid;gap:50px}
  .results-heading{max-width:800px}
  .dimension-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:12px}
  .dimension-card{padding:20px;border:1px solid var(--line);border-radius:16px;background:rgba(255,255,255,.02)}
  .dimension-heading{display:flex;align-items:flex-start;justify-content:space-between;gap:16px}
  .dimension-heading h3{font-size:15px;line-height:1.35;margin:0;font-weight:600}
  .dimension-heading strong{font-family:"Manrope",sans-serif;color:var(--lime);font-size:24px;line-height:1}
  .score-track{height:4px;background:rgba(234,243,239,.1);border-radius:999px;overflow:hidden;margin:25px 0 11px}
  .score-track span{display:block;height:100%;background:var(--lime);border-radius:inherit}
  .dimension-band{font-size:11px;color:var(--muted);text-transform:uppercase;letter-spacing:.1em}
